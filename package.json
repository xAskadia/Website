    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "framer-motion": "^12.43.0",
    "lenis": "^1.3.27",
    "react": "19.1",
    "react-dom": "19.1",
    "react-router": "7.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.1",
    "@types/react-dom": "19.1",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "4.1",
    "typescript": "5.8",
    "vite": "^7.3.7"
  }
}
